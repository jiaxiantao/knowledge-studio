{
  "name": "knowledge-studio",
  "version": "0.1.0",
  "private": false,
  "description": "Local RAG knowledge console: upload docs, chunk + pgvector retrieval, grounded qwen3 Q&A",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiaxiantao/knowledge-studio.git"
  },
  "keywords": [
    "rag",
    "knowledge-base",
    "postgresql",
    "pgvector",
    "nextjs",
    "ai-assistant"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "node .next/standalone/server.js",
    "start:ci": "next start -p 3000",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:extensions": "tsx scripts/db-extensions.ts",
    "db:setup": "pnpm db:extensions && prisma db push --accept-data-loss && prisma db seed",
    "db:studio": "prisma studio",
    "reparse:kb": "node scripts/reparse-kb.mjs",
    "eval:smoke": "tsx scripts/run-rag-eval-smoke.ts",
    "compose:db": "docker compose up -d db",
    "compose:full": "docker compose --profile full up --build -d",
    "compose:full:down": "docker compose --profile full down",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.13",
    "@napi-rs/canvas": "^1.0.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "image-size": "^2.0.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "motion": "^12.42.2",
    "next": "16.2.6",
    "officeparser": "^7.5.1",
    "openai": "^6.39.0",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.21.0",
    "ppt-to-text": "^1.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.6.2",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
