DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_studio?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 默认使用本地 Ollama（OpenAI 兼容接口）
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="qwen3"
OLLAMA_API_KEY="ollama"
OLLAMA_EMBED_MODEL="nomic-embed-text"
# embedding 走原生 Ollama API（无 /v1 后缀）；未设置时从 OLLAMA_BASE_URL 推导
# OLLAMA_NATIVE_BASE_URL="http://127.0.0.1:11434"
UPLOAD_DIR="data/uploads"

# 上传大小上限（字节），默认 20MB
# MAX_UPLOAD_BYTES="20971520"

# 向量召回最低相似度（0–1），默认 0.42
# RAG_MIN_SCORE="0.42"

# 文档解析超过该分钟数仍 pending/parsing 视为卡住，可强制重试，默认 15
# INGEST_STUCK_MINUTES="15"

# CI / 无模型服务时关闭 LLM 调用，回退演示回答
# LLM_DISABLED="1"

# GitHub Pages 静态导出（可选）
# GH_PAGES=1
# GH_PAGES_BASE_PATH="/knowledge-studio"

# 若改用云端 OpenAI 兼容 API，设置 LLM_PROVIDER=openai 并填写：
# LLM_PROVIDER="openai"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY="your-api-key"
# OPENAI_MODEL="gpt-4o-mini"
