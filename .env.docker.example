# 复制为项目根目录 `.env` 后用于：
#   docker compose --profile full up --build -d
#
# 局域网给别人用时，把 NEXT_PUBLIC_SITE_URL 改成 http://<本机局域网IP>:3000

POSTGRES_DB=knowledge_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_PORT=5432

WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 必填：生产/全栈启动校验会拒绝 change-me 占位符
AUTH_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
AUTH_JWT_EXPIRES_IN=7d

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_NATIVE_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3
OLLAMA_API_KEY=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# 对外问答 API：每把 Key 每分钟请求上限
API_CHAT_RATE_LIMIT_RPM=30

# 内网多入口时按需放开，逗号分隔；留空则不附加 CORS 头
# CORS_ORIGINS=http://192.168.1.10:3000,http://ks.internal
