generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  email        String?        @unique
  phone        String?        @unique
  name         String
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  knowledgeBases KnowledgeBase[]
  chatSessions ChatSession[]
  apiKeys      ApiKey[]
}

/// User-scoped API keys for external Q&A (`Authorization: Bearer sk-ks-…`).
model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String    @default("")
  /// Short prefix for list display, e.g. sk-ks-xxxx****yyyy
  keyPrefix   String
  /// SHA-256 hex of the full secret (unique lookup).
  keyHash     String    @unique
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastUsedAt  DateTime?

  @@index([userId])
  @@index([enabled])
}

model KnowledgeBase {
  id          String             @id @default(cuid())
  name        String
  description String?
  userId      String?
  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  documents   Document[]
  categories  DocumentCategory[]
  chatSessions ChatSession[]

  @@index([userId])
}

enum DocumentStatus {
  pending
  parsing
  ready
  failed
}

enum DocumentFormat {
  md
  txt
  html
  pdf
  doc
  docx
  ppt
  pptx
  xls
  xlsx
  png
  jpg
  jpeg
  bmp
  gif
  webp
}

model DocumentCategory {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  name            String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([knowledgeBaseId, name])
  @@index([knowledgeBaseId])
}

model Document {
  id              String         @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  name            String
  format          DocumentFormat
  sizeBytes       Int
  status          DocumentStatus @default(pending)
  /// 0–100 ingest progress while pending/parsing.
  progress        Int            @default(0)
  category        String         @default("默认类目")
  /// Chunking options chosen at upload: strategy, maxChars, overlap, etc.
  chunkConfig     Json?
  errorMessage    String?
  storageKey      String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  indexedAt       DateTime?
  chunks          Chunk[]

  @@index([knowledgeBaseId])
  @@index([status])
  @@index([updatedAt])
}

model Chunk {
  id            String                      @id @default(cuid())
  documentId    String
  document      Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index         Int
  title         String?
  content       String                      @db.Text
  tokenEstimate Int                         @default(0)
  /// leaf = flat chunk; parent = context unit; child = retrieval unit under parent.
  level         ChunkLevel                  @default(leaf)
  parentId      String?
  parent        Chunk?                      @relation("ChunkHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Chunk[]                     @relation("ChunkHierarchy")
  /// When false, chunk is excluded from vector retrieval.
  enabled       Boolean                     @default(true)
  /// Stored as pgvector; written/read via raw SQL.
  embedding     Unsupported("vector(768)")?
  createdAt     DateTime                    @default(now())

  @@unique([documentId, index])
  @@index([documentId])
  @@index([level])
  @@index([parentId])
}

enum ChunkLevel {
  leaf
  parent
  child
}

/// Knowledge Q&A sessions. Branches + messages stored as JSON to match the client model.
model ChatSession {
  id              String         @id
  knowledgeBaseId String?
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  activeBranchId  String
  branches        Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([knowledgeBaseId])
  @@index([userId])
  @@index([updatedAt])
}
